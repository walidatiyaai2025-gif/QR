@using System.Globalization
@model SetupVm
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var brandName = Branding.Name(ar);
    ViewData["Title"] = ar ? "الإعداد الأول" : "First-run setup";
}
<section class="public-center">
    <div class="premium-card">
        <div class="public-title">
            <img class="diwan-card-logo" src="@Branding.LogoPath" alt="@brandName">
            <h1>@brandName</h1>
            <p>@(ar ? "إنشاء حساب مسؤول النظام الأول. يتم تعطيل هذه الشاشة بعد إنشاء أول حساب." : "Create the initial System Administrator. This screen disables itself after the first account is created.")</p>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="field"><label for="DisplayName">@(ar ? "اسم المسؤول" : "Administrator display name")</label><input class="input" asp-for="DisplayName" autocomplete="name"></div>
            <div class="field"><label for="Email">@(ar ? "البريد الإلكتروني" : "Email")</label><input class="input" asp-for="Email" autocomplete="username" dir="ltr"></div>
            <div class="field"><label for="Password">@(ar ? "كلمة المرور" : "Password")</label><input class="input" asp-for="Password" autocomplete="new-password"></div>
            <div class="field"><label for="ConfirmPassword">@(ar ? "تأكيد كلمة المرور" : "Confirm password")</label><input class="input" asp-for="ConfirmPassword" autocomplete="new-password"></div>
            <button class="btn primary block">@(ar ? "إنشاء المسؤول" : "Create administrator")</button>
        </form>
    </div>
</section>
