@using System.Globalization
@model ValueTuple<string,string,string>
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = Model.Item2;
}
<section class="public-center"><div class="premium-card error-card"><img class="diwan-card-logo" src="@Branding.LogoPath" alt="@(ar ? Branding.ArabicName : Branding.EnglishName)"><div class="error-code">@Model.Item1</div><h1>@Model.Item2</h1><p>@Model.Item3</p><a class="btn primary" href="/">@(ar ? "الرئيسية" : "Home")</a></div></section>
