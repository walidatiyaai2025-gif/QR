@using System.Globalization
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";
 var brandName=Branding.Name(ar);
}
<!doctype html>
<html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")">
<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
 <meta name="theme-color" content="#07111f">
 <title>@ViewData["Title"] — @brandName</title>
 <link rel="icon" type="image/jpeg" href="@Branding.LogoPath">
 <link rel="apple-touch-icon" href="@Branding.LogoPath">
 <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
 <link rel="stylesheet" href="~/css/qr-share.css" asp-append-version="true">
 <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true">
</head>
<body class="public-body">
<header class="public-top">
 <a class="brand diwan-brand" href="/" aria-label="@brandName">
  <img class="brand-logo" src="@Branding.LogoPath" alt="@brandName">
  <span class="brand-name">@brandName</span>
 </a>
 <div class="lang"><a href="/Localization/Switch?culture=ar&returnUrl=@Uri.EscapeDataString(Context.Request.Path+Context.Request.QueryString)">AR</a><span>/</span><a href="/Localization/Switch?culture=en&returnUrl=@Uri.EscapeDataString(Context.Request.Path+Context.Request.QueryString)">EN</a></div>
</header>
<main>@RenderBody()</main>
<footer class="public-footer"><img src="@Branding.LogoPath" alt=""><span>@brandName</span></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts",required:false)
</body>
</html>
