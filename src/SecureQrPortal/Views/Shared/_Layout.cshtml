@using System.Globalization
@inject AppSettingsService AppSettings
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";
 var appName=await AppSettings.GetAsync("ApplicationName","Secure QR Portal");
}
<!doctype html><html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>@ViewData["Title"] — @appName</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head>
<body class="public-body"><header class="public-top"><a class="brand" href="/"><span class="brand-mark">QR</span><span>@appName</span></a><div class="lang"><a href="/Localization/Switch?culture=ar&returnUrl=@Uri.EscapeDataString(Context.Request.Path+Context.Request.QueryString)">AR</a><span>/</span><a href="/Localization/Switch?culture=en&returnUrl=@Uri.EscapeDataString(Context.Request.Path+Context.Request.QueryString)">EN</a></div></header><main>@RenderBody()</main><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
