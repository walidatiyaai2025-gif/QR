@using System.Globalization
@model SecurePage
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var org = ar ? Model.Organization.NameArabic : Model.Organization.NameEnglish;
    var title = ar ? Model.TitleArabic : Model.TitleEnglish;
    var brandName = Branding.Name(ar);
    var token = ViewContext.RouteData.Values["token"]?.ToString() ?? string.Empty;
    var loginUrl = Url.Action("Login", "PublicQr", new { token }) ?? $"/q/{token}/login";
    var secureUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/q/{token}";
    ViewData["Title"] = title;
}
<section class="public-center secure-page-shell">
    <div class="premium-card secure-login-card">
        <div class="public-title">
            <img class="diwan-card-logo" src="@Branding.LogoPath" alt="@brandName">
            <div class="qr-org-title">@org</div>
            <div class="security-kicker">@Model.QrReference</div>
            <h1>@brandName</h1>
            <p class="secure-page-title">@title</p>
        </div>
        <div class="secure-address"><span>@(ar?"الرابط الآمن":"Secure address")</span><strong class="url">@secureUrl</strong></div>
        @if(ViewBag.LoginError is string e){<div class="alert danger">@e</div>}
        <form method="post" action="@loginUrl">
            @Html.AntiForgeryToken()
            <div class="field"><label>@(ar?"اسم المستخدم":"Username")</label><input class="input" name="username" autocomplete="username" required></div>
            <div class="field"><label>@(ar?"كلمة المرور":"Password")</label><div class="password-wrap"><input class="input" id="pagePassword" type="password" name="password" autocomplete="current-password" required><button type="button" class="password-toggle" data-password-toggle="pagePassword" aria-label="@(ar?"إظهار أو إخفاء كلمة المرور":"Show or hide password")">◉</button></div></div>
            <button class="btn primary block" type="submit">@(ar?"فتح المحتوى الآمن":"Open secure content")</button>
        </form>
        <p class="public-security-note">@(ar?"الوصول محمي ومراقب بواسطة الديوان الأميري.":"Access is protected and monitored by Al Diwan Al Amiri.")</p>
    </div>
</section>
