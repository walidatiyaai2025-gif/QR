@using System.Globalization
@model SecurePage
@{var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var org=ar?Model.Organization.NameArabic:Model.Organization.NameEnglish;var title=ar?Model.TitleArabic:Model.TitleEnglish;ViewData["Title"]=title;}
<section class="public-center"><div class="premium-card">@if(!string.IsNullOrWhiteSpace(Model.Organization.LogoPath)){<img class="org-logo" src="@Model.Organization.LogoPath" alt="@org">}<div class="public-title"><div class="muted" style="font-size:12px;letter-spacing:.6px">@Model.QrReference</div><h1>@org</h1><p>@title</p></div>@if(ViewBag.LoginError is string e){<div class="alert danger">@e</div>}<form method="post" action="@Context.Request.Path/login">@Html.AntiForgeryToken()<div class="field"><label>@(ar?"اسم المستخدم":"Username")</label><input class="input" name="username" autocomplete="username" required></div><div class="field"><label>@(ar?"كلمة المرور":"Password")</label><div class="password-wrap"><input class="input" id="pagePassword" type="password" name="password" autocomplete="current-password" required><button type="button" class="password-toggle" data-password-toggle="pagePassword">◉</button></div></div><button class="btn primary block" type="submit">@(ar?"فتح المحتوى الآمن":"Open secure content")</button></form></div></section>
