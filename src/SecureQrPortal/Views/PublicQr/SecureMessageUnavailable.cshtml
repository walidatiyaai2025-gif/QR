@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = ar ? "الرسالة غير متاحة مؤقتًا" : "Secure Message unavailable";
}
<section class="public-center secure-page-shell">
    <article class="premium-card secure-content-card">
        <div class="public-title">
            <img class="diwan-card-logo" src="@Branding.LogoPath" alt="@Branding.Name(ar)">
            <h1>@(ar ? "الرسالة غير متاحة مؤقتًا" : "Secure Message temporarily unavailable")</h1>
            <p>@(ar
                ? "تم إيقاف فتح الرسائل المشفرة مؤقتًا من إعدادات أمان النظام. لم يتم حذف الرسالة أو مفاتيحها بسبب هذا الإيقاف المؤقت."
                : "Secure Message reveal is temporarily blocked by system security settings. The message and its key were not destroyed by this temporary block.")</p>
        </div>
    </article>
</section>
