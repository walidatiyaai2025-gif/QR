@model ChangePasswordVm
@{ViewData["Title"]="Change password";}
<section class="public-center"><div class="premium-card"><div class="public-title"><h1>Change password</h1><p>Use a strong unique administrator password.</p></div>@if(TempData["Success"] is string s){<div class="alert success">@s</div>}<form method="post"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="CurrentPassword"></label><input class="input" asp-for="CurrentPassword"></div><div class="field"><label asp-for="NewPassword"></label><input class="input" asp-for="NewPassword"></div><div class="field"><label asp-for="ConfirmPassword"></label><input class="input" asp-for="ConfirmPassword"></div><button class="btn primary block">Update password</button></form></div></section>
