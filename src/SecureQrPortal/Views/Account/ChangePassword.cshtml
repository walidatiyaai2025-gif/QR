@using System.Globalization
@model ChangePasswordVm
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = ar ? "تغيير كلمة المرور" : "Change password";
}
<section class="public-center">
    <div class="premium-card">
        <div class="public-title">
            <img class="diwan-card-logo" src="@Branding.LogoPath" alt="@(ar ? Branding.ArabicName : Branding.EnglishName)">
            <h1>@(ar ? "تغيير كلمة المرور" : "Change password")</h1>
            <p>@(ar ? "استخدم كلمة مرور قوية وفريدة لحساب المسؤول." : "Use a strong unique administrator password.")</p>
        </div>
        @if(TempData["Success"] is string s){<div class="alert success">@s</div>}
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="field"><label for="CurrentPassword">@(ar ? "كلمة المرور الحالية" : "Current password")</label><input class="input" asp-for="CurrentPassword" autocomplete="current-password"></div>
            <div class="field"><label for="NewPassword">@(ar ? "كلمة المرور الجديدة" : "New password")</label><input class="input" asp-for="NewPassword" autocomplete="new-password"></div>
            <div class="field"><label for="ConfirmPassword">@(ar ? "تأكيد كلمة المرور الجديدة" : "Confirm new password")</label><input class="input" asp-for="ConfirmPassword" autocomplete="new-password"></div>
            <button class="btn primary block">@(ar ? "تحديث كلمة المرور" : "Update password")</button>
        </form>
    </div>
</section>
