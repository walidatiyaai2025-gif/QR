@model LoginVm
@{ViewData["Title"]="Administrator Login";}
<section class="public-center"><div class="premium-card"><div class="public-title"><div class="brand-mark" style="margin:auto">QR</div><h1>Admin Console</h1><p>Secure QR Portal administration</p></div><form method="post"><div asp-validation-summary="ModelOnly"></div><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><div class="field"><label asp-for="Email"></label><input class="input" asp-for="Email" autocomplete="username"></div><div class="field"><label asp-for="Password"></label><div class="password-wrap"><input class="input" asp-for="Password" id="adminPassword" autocomplete="current-password"><button type="button" class="password-toggle" data-password-toggle="adminPassword">◉</button></div></div><label class="check" style="margin-bottom:18px"><input asp-for="RememberMe"> Remember me</label><button class="btn primary block" type="submit">Sign in</button><p class="muted" style="text-align:center;font-size:12px;margin-top:18px">First installation? <a style="color:var(--gold2)" href="/setup">Run first-time setup</a></p></form></div></section>
