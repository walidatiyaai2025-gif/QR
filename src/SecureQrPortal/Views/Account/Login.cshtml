@using System.Globalization
@model LoginVm
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";
 var brandName=Branding.Name(ar);
 ViewData["Title"]=ar?"دخول المسؤول":"Administrator Login";
}
<section class="public-center"><div class="premium-card"><div class="public-title"><img class="diwan-card-logo" src="@Branding.LogoPath" alt="@brandName"><h1>@brandName</h1><p>@(ar?"لوحة إدارة الوصول الآمن عبر QR":"Secure QR administration console")</p></div><form method="post"><div asp-validation-summary="ModelOnly"></div><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><div class="field"><label for="Email">@(ar?"البريد الإلكتروني":"Email")</label><input class="input" asp-for="Email" autocomplete="username" dir="ltr"></div><div class="field"><label for="Password">@(ar?"كلمة المرور":"Password")</label><div class="password-wrap"><input class="input" asp-for="Password" id="adminPassword" autocomplete="current-password"><button type="button" class="password-toggle" data-password-toggle="adminPassword" aria-label="@(ar?"إظهار أو إخفاء كلمة المرور":"Show or hide password")">◉</button></div></div><label class="check" style="margin-bottom:18px"><input asp-for="RememberMe"> @(ar?"تذكرني":"Remember me")</label><button class="btn primary block" type="submit">@(ar?"تسجيل الدخول":"Sign in")</button><p class="muted" style="text-align:center;font-size:12px;margin-top:18px">@(ar?"أول تشغيل؟":"First installation?") <a style="color:var(--gold2)" href="/setup">@(ar?"إعداد المسؤول الأول":"Run first-time setup")</a></p></form></div></section>
