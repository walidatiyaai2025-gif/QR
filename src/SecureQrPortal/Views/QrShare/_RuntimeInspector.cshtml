@{
    var runtimeInspector = ViewBag.RuntimeInspector as string;
    var inspectorEnabled = ViewBag.RuntimeInspectorEnabled == true && !string.IsNullOrWhiteSpace(runtimeInspector);
}
@if (inspectorEnabled)
{
    <details class="premium-card" open style="margin-top:18px; max-width:980px; width:min(980px,calc(100vw - 32px));">
        <summary style="cursor:pointer; font-weight:800;">Runtime Inspector</summary>
        <p class="muted" style="margin-top:10px;">Diagnostic only. Raw share tokens, passwords, antiforgery values, and receipt cookies are never written to this panel or the log file.</p>
        <div class="secure-address" style="margin-top:12px;">
            <span>Text log</span>
            <strong class="url">@(ViewBag.RuntimeInspectorLogPath ?? "logs/qr-share-runtime-inspector.txt")</strong>
        </div>
        <pre style="white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; margin-top:12px; padding:14px; border-radius:12px; background:rgba(0,0,0,.25); font-size:12px; line-height:1.6;">@runtimeInspector</pre>
    </details>
}
