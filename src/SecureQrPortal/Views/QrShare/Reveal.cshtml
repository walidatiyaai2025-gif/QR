@using System.Globalization
@model QrShareRevealVm
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = ar ? "بيانات الوصول الآمن" : "Secure access credentials";

    var rawEnd = Model.Share.AccessWindowEndsAtUtc ?? DateTime.UtcNow;
    var endUtc = rawEnd.Kind == DateTimeKind.Utc
        ? rawEnd
        : DateTime.SpecifyKind(rawEnd, DateTimeKind.Utc);
}
<section class="public-center share-shell">
    <div class="premium-card share-card">
        <div class="public-title">
            <div class="security-kicker">@(ar ? "تم فتح رابط المشاركة" : "SHARE LINK OPENED")</div>
            <h1>@Model.Organization</h1>
            <p>@Model.PageTitle</p>
        </div>
        <div class="alert success">@(ar ? "تم احتساب هذا الفتح. البيانات التالية هي نفس اسم المستخدم وكلمة المرور الحالية المستخدمة لفتح صفحة الـ QR." : "This opening has been counted. The credentials below are the same current username and password used to open the QR page.")</div>
        <div class="credential-grid">
            <div class="credential-box"><span>@(ar ? "اسم المستخدم الحالي" : "Current username")</span><strong class="code">@Model.Username</strong><button type="button" class="link-button" data-copy="@Model.Username">@(ar ? "نسخ" : "Copy")</button></div>
            <div class="credential-box"><span>@(ar ? "كلمة مرور الـ QR الحالية" : "Current QR password")</span><strong class="code">@Model.Password</strong><button type="button" class="link-button" data-copy="@Model.Password">@(ar ? "نسخ" : "Copy")</button></div>
        </div>
        <div class="secure-address share-destination">
            <span>@(ar ? "رابط QR الآمن" : "Secure QR link")</span>
            <strong class="url">@Model.PublicQrUrl</strong>
            <button type="button" class="link-button" data-copy="@Model.PublicQrUrl">@(ar ? "نسخ الرابط" : "Copy link")</button>
        </div>
        <dl class="share-facts">
            <dt>@(ar ? "نهاية مدة عرض المشاركة" : "Share display window ends")</dt><dd id="shareExpiryText">@endUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</dd>
            <dt>@(ar ? "مرات الفتح المستخدمة" : "Reveal usage")</dt><dd>@Model.Share.CurrentOpenCount / @Model.Share.MaxOpenCount</dd>
        </dl>
        <a class="btn primary block" href="@Model.PublicQrUrl" rel="noopener">@(ar ? "فتح صفحة QR وإدخال البيانات" : "Open QR page and sign in")</a>
        <p class="share-hint">@(ar ? "انتهاء مدة عرض المشاركة يغلق هذه الشاشة، لكنه لا يغيّر كلمة مرور الـ QR الأصلية. إذا كان المطلوب إبطال كلمة المرور نفسها فيجب تغيير بيانات دخول صفحة الـ QR من الإدارة." : "When this share display window ends, this screen closes, but the base QR password is not changed. To invalidate the password itself, change the QR page credentials in Admin.")</p>
    </div>
    <partial name="_RuntimeInspector" />
</section>
@section Scripts {
<script>
(function(){
  const expires = Date.parse('@endUtc.ToString("O")');
  const ms = expires - Date.now();
  if (ms <= 0) { window.location.replace('@Url.Action("Open", "QrShare", new { token = "expired" })'); return; }
  window.setTimeout(function(){
    document.body.innerHTML = '<main class="public-center"><div class="premium-card error-card"><div class="error-code">⏱</div><h1>@(ar ? "انتهت مدة عرض المشاركة" : "Share display window expired")</h1><p class="muted">@(ar ? "تم إخفاء بيانات الدخول من شاشة المشاركة. كلمة مرور الـ QR الأصلية لم يتم تغييرها." : "The credentials have been hidden from the share screen. The base QR password has not been changed.")</p></div></main>';
  }, Math.min(ms, 2147483647));
})();
</script>
}
