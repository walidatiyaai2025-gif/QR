@model DashboardVm
@{ViewData["Title"]="Dashboard";}
<div class="page-head"><div><h1>System Overview</h1><p>Authoritative QR, access, validity and security activity at a glance.</p></div><div class="actions"><a class="btn primary" asp-controller="SecurePages" asp-action="Create">+ Secure Page</a><a class="btn secondary" asp-controller="Qr" asp-action="Index">QR Registry</a></div></div>
<div class="metrics"><div class="metric"><div class="label">TOTAL QR CODES</div><div class="value">@Model.TotalQr</div><div class="sub">@Model.ActivePages active</div></div><div class="metric"><div class="label">SCANS TODAY</div><div class="value">@Model.ScansToday</div><div class="sub">@Model.ScansMonth this month</div></div><div class="metric"><div class="label">SUCCESSFUL ACCESSES TODAY</div><div class="value">@Model.SuccessfulToday</div><div class="sub">Server-authoritative count</div></div><div class="metric"><div class="label">FAILED LOGINS TODAY</div><div class="value">@Model.FailedToday</div><div class="sub">Security signal</div></div><div class="metric"><div class="label">EXPIRED</div><div class="value">@Model.ExpiredPages</div><div class="sub">No login is shown publicly</div></div><div class="metric"><div class="label">DISABLED</div><div class="value">@Model.DisabledPages</div><div class="sub">Administrative state</div></div><div class="metric"><div class="label">REVOKED</div><div class="value">@Model.RevokedQr</div><div class="sub">Token/page revoked</div></div><div class="metric"><div class="label">LIMIT REACHED</div><div class="value">@Model.LimitReachedQr</div><div class="sub">Access policy exhausted</div></div></div>
<div class="details-grid"><section class="panel"><div class="panel-head"><h2>Most Used QR Codes</h2><a class="muted" asp-controller="Qr" asp-action="Index">View all</a></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Reference</th><th>Organization / Page</th><th>Scans</th><th>Successful</th></tr></thead><tbody>@foreach(var x in Model.MostUsed){<tr><td><a class="code" asp-controller="Qr" asp-action="Details" asp-route-id="@x.Id">@x.Ref</a></td><td><strong>@x.Organization</strong><br><span class="muted">@x.Title</span></td><td>@x.Scans</td><td>@x.Success</td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-head"><h2>Expiring Soon</h2><span class="muted">Next 30 days</span></div><div class="panel-body"><div class="timeline">@foreach(var x in Model.ExpiringSoon){<div class="timeline-item"><strong><a asp-controller="Qr" asp-action="Details" asp-route-id="@x.Id">@x.Ref — @x.Title</a></strong><small>@x.Organization · @x.Expiry.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></div>}@if(Model.ExpiringSoon.Count==0){<p class="muted">No QR codes are expiring in the next 30 days.</p>}</div></div></section></div>
<section class="panel"><div class="panel-head"><h2>Recent Activity</h2><a class="muted" asp-controller="Logs" asp-action="Access">Full access log</a></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Time</th><th>Event</th><th>QR / Page</th><th>Result</th><th>IP</th><th>Device</th></tr></thead><tbody>@foreach(var x in Model.RecentActivity){<tr><td>@x.TimestampUtc.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@x.EventType</td><td>@(x.SecurePage?.QrReference??"—")<br><span class="muted">@(x.SecurePage?.TitleEnglish??"Unknown token")</span></td><td>@(x.WasSuccessful?"SUCCESS":"FAILED")</td><td>@(x.IpAddress??"—")</td><td>@x.DeviceType / @x.Browser</td></tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-head"><h2>Demo Data</h2><span class="muted">Delete demo records only. Production data is never selected by this operation.</span></div><div class="panel-body"><form asp-controller="Demo" asp-action="Delete" method="post" onsubmit="return confirm('Delete all records marked as demo data? Production records will not be deleted.');"><input type="hidden" name="confirmation" value="DELETE DEMO"><button class="btn danger" type="submit">Delete Demo Data Only</button></form></div></section>
