@model DashboardVm
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string arText, string enText) => ar ? arText : enText;
    ViewData["Title"] = T["Dashboard"];
}
<div class="page-head">
    <div><h1>@L("نظرة عامة على النظام", "System Overview")</h1><p>@L("مؤشرات موثوقة من الخادم لرموز QR والوصول والصلاحية والنشاط الأمني.", "Authoritative QR, access, validity and security activity at a glance.")</p></div>
    <div class="actions"><a class="btn primary" asp-controller="SecurePages" asp-action="Create">+ @T["NewSecurePage"]</a><a class="btn secondary" asp-controller="Qr" asp-action="Index">@T["QrRegistry"]</a></div>
</div>
<div class="metrics">
    <div class="metric"><div class="label">@L("إجمالي رموز QR", "TOTAL QR CODES")</div><div class="value">@Model.TotalQr</div><div class="sub">@Model.ActivePages @L("نشط", "active")</div></div>
    <div class="metric"><div class="label">@L("عمليات المسح اليوم", "SCANS TODAY")</div><div class="value">@Model.ScansToday</div><div class="sub">@Model.ScansMonth @L("هذا الشهر", "this month")</div></div>
    <div class="metric"><div class="label">@L("الوصول الناجح اليوم", "SUCCESSFUL ACCESSES TODAY")</div><div class="value">@Model.SuccessfulToday</div><div class="sub">@L("عداد موثوق من الخادم", "Server-authoritative count")</div></div>
    <div class="metric"><div class="label">@L("محاولات الدخول الفاشلة اليوم", "FAILED LOGINS TODAY")</div><div class="value">@Model.FailedToday</div><div class="sub">@L("مؤشر أمني", "Security signal")</div></div>
    <div class="metric"><div class="label">@T["EXPIRED"]</div><div class="value">@Model.ExpiredPages</div><div class="sub">@L("لا تظهر شاشة الدخول للعامة", "No login is shown publicly")</div></div>
    <div class="metric"><div class="label">@T["DISABLED"]</div><div class="value">@Model.DisabledPages</div><div class="sub">@L("حالة إدارية", "Administrative state")</div></div>
    <div class="metric"><div class="label">@T["REVOKED"]</div><div class="value">@Model.RevokedQr</div><div class="sub">@L("تم إلغاء الرمز/الصفحة", "Token/page revoked")</div></div>
    <div class="metric"><div class="label">@T["LIMIT_REACHED"]</div><div class="value">@Model.LimitReachedQr</div><div class="sub">@L("تم استهلاك سياسة الوصول", "Access policy exhausted")</div></div>
</div>
<div class="details-grid">
    <section class="panel">
        <div class="panel-head"><h2>@L("أكثر رموز QR استخداماً", "Most Used QR Codes")</h2><a class="muted" asp-controller="Qr" asp-action="Index">@L("عرض الكل", "View all")</a></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>@L("المرجع", "Reference")</th><th>@T["OrganizationPage"]</th><th>@L("المسح", "Scans")</th><th>@L("الوصول الناجح", "Successful")</th></tr></thead><tbody>@foreach(var x in Model.MostUsed){<tr><td><a class="code" asp-controller="Qr" asp-action="Details" asp-route-id="@x.Id">@x.Ref</a></td><td><strong>@x.Organization</strong><br><span class="muted">@x.Title</span></td><td>@x.Scans</td><td>@x.Success</td></tr>}@if(Model.MostUsed.Count==0){<tr><td colspan="4" class="muted">@L("لا توجد بيانات استخدام حتى الآن.", "No usage data yet.")</td></tr>}</tbody></table></div>
    </section>
    <section class="panel">
        <div class="panel-head"><h2>@L("تنتهي قريباً", "Expiring Soon")</h2><span class="muted">@L("خلال 30 يوماً", "Next 30 days")</span></div>
        <div class="panel-body"><div class="timeline">@foreach(var x in Model.ExpiringSoon){<div class="timeline-item"><strong><a asp-controller="Qr" asp-action="Details" asp-route-id="@x.Id">@x.Ref — @x.Title</a></strong><small>@x.Organization · @x.Expiry.ToLocalTime().ToString(ar ? "dd/MM/yyyy HH:mm" : "dd MMM yyyy HH:mm")</small></div>}@if(Model.ExpiringSoon.Count==0){<p class="muted">@L("لا توجد رموز QR تنتهي خلال الثلاثين يوماً القادمة.", "No QR codes are expiring in the next 30 days.")</p>}</div></div>
    </section>
</div>
<section class="panel">
    <div class="panel-head"><h2>@L("النشاط الأخير", "Recent Activity")</h2><a class="muted" asp-controller="Logs" asp-action="Access">@L("سجل الوصول الكامل", "Full access log")</a></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>@L("الوقت", "Time")</th><th>@T["Event"]</th><th>@L("QR / الصفحة", "QR / Page")</th><th>@T["Result"]</th><th>@T["IP"]</th><th>@L("الجهاز", "Device")</th></tr></thead><tbody>@foreach(var x in Model.RecentActivity){<tr><td>@x.TimestampUtc.ToLocalTime().ToString(ar ? "dd/MM HH:mm" : "dd MMM HH:mm")</td><td>@T[x.EventType]</td><td>@(x.SecurePage?.QrReference??"—")<br><span class="muted">@(x.SecurePage is null ? T["UnknownToken"] : (ar ? x.SecurePage.TitleArabic : x.SecurePage.TitleEnglish))</span></td><td>@(x.WasSuccessful?T["Success"]:T["Failure"])</td><td>@(x.IpAddress??"—")</td><td>@x.DeviceType / @x.Browser</td></tr>}@if(Model.RecentActivity.Count==0){<tr><td colspan="6" class="muted">@L("لا يوجد نشاط مسجل.", "No activity recorded.")</td></tr>}</tbody></table></div>
</section>
<section class="panel">
    <div class="panel-head"><h2>@T["DemoData"]</h2><span class="muted">@L("يحذف السجلات التجريبية فقط. بيانات الإنتاج لا يتم اختيارها في هذه العملية.", "Delete demo records only. Production data is never selected by this operation.")</span></div>
    <div class="panel-body"><form asp-controller="Demo" asp-action="Delete" method="post" onsubmit="return confirm('@L("حذف كل السجلات المحددة كبيانات تجريبية؟ لن يتم حذف بيانات الإنتاج.", "Delete all records marked as demo data? Production records will not be deleted.")');"><input type="hidden" name="confirmation" value="DELETE DEMO"><button class="btn danger" type="submit">@L("حذف البيانات التجريبية فقط", "Delete Demo Data Only")</button></form></div>
</section>
