@model Organization
@{ViewData["Title"]=Model.Id==0?"Create Organization":"Edit Organization";}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Uploads are validated and stored under generated safe filenames.</p></div><a class="btn secondary" asp-action="Index">Back</a></div><section class="panel"><div class="panel-body"><form method="post" asp-action="Edit" enctype="multipart/form-data"><input type="hidden" asp-for="Id"><div asp-validation-summary="ModelOnly"></div><div class="form-grid"><div class="field"><label>English name</label><input class="input" asp-for="NameEnglish" required></div><div class="field"><label>Arabic name</label><input class="input" asp-for="NameArabic" dir="rtl" required></div><div class="field"><label>Logo (PNG/JPG/WEBP, max 3 MB)</label><input class="input" type="file" name="logo" accept="image/png,image/jpeg,image/webp"></div><div class="field"><label>Current logo</label>@if(Model.LogoPath is not null){<img src="@Model.LogoPath" style="height:90px;object-fit:contain;background:white;border-radius:12px;padding:6px">}<span class="muted">@Model.LogoPath</span>@if(Model.LogoPath is not null){<label class="check" style="margin-top:8px"><input type="checkbox" name="removeLogo" value="true"> Remove current logo</label>}</div><label class="check span-2"><input asp-for="IsActive"> Active organization</label></div><div class="actions" style="margin-top:20px"><button class="btn primary">Save organization</button><a class="btn secondary" asp-action="Index">Cancel</a></div></form></div></section>
