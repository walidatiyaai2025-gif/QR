@model Organization
@using SecureQrPortal.ViewModels
@{
    var creating = Model.Id == 0;
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var devices = ViewBag.MobileDevices as IEnumerable<MobileDeviceAdminVm> ?? Array.Empty<MobileDeviceAdminVm>();
    ViewData["Title"] = creating ? T["CreateOrganization"] : T["EditOrganization"];
}
<link rel="stylesheet" href="~/css/admin-closure.css" asp-append-version="true" />
<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>@T["OrganizationFormHelp"]</p>
    </div>
    <a class="btn secondary" asp-action="Index">@T["Back"]</a>
</div>
<section class="panel">
    <div class="panel-body">
        <div class="branding-policy-note">
            <img src="@Branding.LogoPath" alt="@Branding.EnglishName">
            <div><strong>@Branding.EnglishName</strong><span>System branding is fixed to Al Diwan Al Amiri. Organizations provide names only; organization-specific logos are not used.</span></div>
        </div>
        <form method="post" asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="NameEnglish">@T["EnglishName"]</label>
                    <input class="input" asp-for="NameEnglish" autocomplete="organization" required />
                </div>
                <div class="field">
                    <label asp-for="NameArabic">@T["ArabicName"]</label>
                    <input class="input" asp-for="NameArabic" dir="rtl" autocomplete="off" required />
                </div>
                <div class="field span-2">
                    <label asp-for="MobileNumber">@(ar ? "رقم الجوال المسجل للتطبيق" : "Registered Mobile Number")</label>
                    <input class="input" asp-for="MobileNumber" dir="ltr" type="tel" inputmode="tel" autocomplete="tel" placeholder="+965 5000 0000" />
                    <span asp-validation-for="MobileNumber"></span>
                    <small>@(ar ? "يُستخدم لتسجيل الدخول إلى DA Secure عبر OTP. يقبل 8 أرقام كويتية أو صيغة +965." : "Used for DA Secure OTP sign-in. Enter 8 Kuwait digits or a +965 number.")</small>
                </div>
                <label class="check span-2" asp-for="IsActive"><input asp-for="IsActive" /> @T["ActiveOrganization"]</label>
            </div>
            <div class="actions mobile-stack" style="margin-top:20px">
                <button class="btn primary" type="submit">@T["SaveOrganization"]</button>
                <a class="btn secondary" asp-action="Index">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</section>

@if (!creating)
{
    <section class="panel" style="margin-top:16px">
        <div class="panel-head">
            <div>
                <h2>@(ar ? "أجهزة DA Secure المسجلة" : "Registered DA Secure Devices")</h2>
                <p class="muted">@(ar ? "يتم عرض الحالة التشغيلية الآمنة فقط. رموز FCM وبيانات الجلسات غير معروضة." : "Only safe operational state is shown. FCM and session secrets are never displayed.")</p>
            </div>
        </div>
        <div class="table-wrap admin-stack">
            <table class="data-table admin-responsive-table">
                <thead>
                    <tr>
                        <th>@(ar ? "المنصة" : "Platform")</th>
                        <th>@(ar ? "إصدار التطبيق" : "App Version")</th>
                        <th>@(ar ? "الإشعارات" : "Push")</th>
                        <th>@(ar ? "تاريخ التسجيل" : "Registered")</th>
                        <th>@(ar ? "آخر ظهور" : "Last Seen")</th>
                        <th>@T["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var device in devices)
                {
                    <tr>
                        <td data-label="@(ar ? "المنصة" : "Platform")">@device.Platform</td>
                        <td data-label="@(ar ? "إصدار التطبيق" : "App Version")"><span class="numeric">@device.AppVersion</span></td>
                        <td data-label="@(ar ? "الإشعارات" : "Push")">@(device.PushEnabled ? (ar ? "مفعلة" : "Enabled") : (ar ? "معطلة" : "Disabled"))</td>
                        <td data-label="@(ar ? "تاريخ التسجيل" : "Registered")"><span class="numeric">@device.RegisteredAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yyyy HH:mm" : "dd MMM yyyy HH:mm")</span></td>
                        <td data-label="@(ar ? "آخر ظهور" : "Last Seen")"><span class="numeric">@device.LastSeenAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yyyy HH:mm" : "dd MMM yyyy HH:mm")</span></td>
                        <td data-label="@T["Status"]"><span class="badge @(device.IsActive ? "ACTIVE" : "DISABLED")">@(device.IsActive ? T["ACTIVE"] : T["DISABLED"])</span></td>
                    </tr>
                }
                @if (!devices.Any())
                {
                    <tr><td colspan="6" class="muted">@(ar ? "لا يوجد جهاز DA Secure مسجل" : "No registered DA Secure device")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
