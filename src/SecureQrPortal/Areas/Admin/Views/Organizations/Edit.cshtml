@model Organization
@{
    var creating = Model.Id == 0;
    ViewData["Title"] = creating ? T["CreateOrganization"] : T["EditOrganization"];
}
<link rel="stylesheet" href="~/css/admin-closure.css" asp-append-version="true" />
<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>@T["OrganizationFormHelp"]</p>
    </div>
    <a class="btn secondary" asp-action="Index">@T["Back"]</a>
</div>
<section class="panel">
    <div class="panel-body">
        <form method="post" asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="NameEnglish">@T["EnglishName"]</label>
                    <input class="input" asp-for="NameEnglish" autocomplete="organization" required />
                </div>
                <div class="field">
                    <label asp-for="NameArabic">@T["ArabicName"]</label>
                    <input class="input" asp-for="NameArabic" dir="rtl" autocomplete="off" required />
                </div>
                <div class="field">
                    <label for="organization-logo">@T["LogoUpload"]</label>
                    <input class="input" id="organization-logo" type="file" name="logo" accept="image/png,image/jpeg,image/webp" />
                </div>
                <div class="field">
                    <label>@T["CurrentLogo"]</label>
                    @if (Model.LogoPath is not null)
                    {
                        <img src="@Model.LogoPath" alt="@T["OrganizationLogoAlt"]" style="height:90px;object-fit:contain;background:white;border-radius:12px;padding:6px" />
                    }
                    <span class="muted" dir="ltr">@Model.LogoPath</span>
                    @if (Model.LogoPath is not null)
                    {
                        <label class="check" for="remove-logo" style="margin-top:8px"><input id="remove-logo" type="checkbox" name="removeLogo" value="true" /> @T["RemoveCurrentLogo"]</label>
                    }
                </div>
                <label class="check span-2" asp-for="IsActive"><input asp-for="IsActive" /> @T["ActiveOrganization"]</label>
            </div>
            <div class="actions mobile-stack" style="margin-top:20px">
                <button class="btn primary" type="submit">@T["SaveOrganization"]</button>
                <a class="btn secondary" asp-action="Index">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</section>
