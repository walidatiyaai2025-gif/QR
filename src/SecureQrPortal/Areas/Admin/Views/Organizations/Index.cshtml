@model List<SecureQrPortal.ViewModels.OrganizationAdminListItemVm>
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = T["Organizations"];
}
<link rel="stylesheet" href="~/css/admin-closure.css" asp-append-version="true" />
<div class="page-head">
    <div>
        <h1>@T["Organizations"]</h1>
        <p>@T["OrganizationsSubtitle"]</p>
    </div>
    <a class="btn primary" asp-action="Create">+ @T["NewOrganization"]</a>
</div>
<section class="panel">
    <div class="panel-head">
        <div class="admin-brand-inline"><img src="@Branding.LogoPath" alt="@Branding.EnglishName"><span>@Branding.EnglishName</span></div>
        <form method="get" class="actions" role="search">
            <label class="sr-only" for="organization-search">@T["SearchOrganizations"]</label>
            <input class="input" id="organization-search" name="q" value="@Context.Request.Query["q"]" placeholder="@T["SearchOrganizations"]" autocomplete="off" />
            <button class="btn secondary" type="submit">@T["Search"]</button>
        </form>
    </div>
    <div class="table-wrap admin-stack">
        <table class="data-table admin-responsive-table">
            <thead>
                <tr><th>@T["English"]</th><th>@T["Arabic"]</th><th>الجوال / Mobile</th><th>DA Secure</th><th>@T["Status"]</th><th>@T["Created"]</th><th>@T["Actions"]</th></tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                var statusKey = o.IsActive ? "ACTIVE" : "DISABLED";
                <tr>
                    <td data-label="@T["English"]">@o.NameEnglish @if(o.IsDemo){<span class="badge NOT_STARTED">@T["Demo"]</span>}</td>
                    <td data-label="@T["Arabic"]" dir="rtl">@o.NameArabic</td>
                    <td data-label="الجوال / Mobile" class="numeric">@(o.MobileNumber ?? "—")</td>
                    <td data-label="DA Secure">
                        <span class="badge @(o.IsMobileReady ? "ACTIVE" : "DISABLED")">@(o.IsMobileReady ? "جاهز / Ready" : "غير جاهز / Not ready")</span>
                        <small class="muted" style="display:block">@o.ActiveDeviceCount device(s)@if (o.LastSeenAtUtc.HasValue){<text> · @o.LastSeenAtUtc.Value.ToLocalTime().ToString("g")</text>}</small>
                    </td>
                    <td data-label="@T["Status"]"><span class="badge @statusKey">@T[statusKey]</span></td>
                    <td data-label="@T["Created"]"><span class="numeric">@o.CreatedAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yyyy" : "dd MMM yyyy")</span></td>
                    <td data-label="@T["Actions"]" data-actions>
                        <div class="actions">
                            <a class="btn secondary" asp-action="Edit" asp-route-id="@o.Id">@T["Edit"]</a>
                            <form method="post" asp-action="Delete" asp-route-id="@o.Id" class="actions" onsubmit="return confirm('@T["ConfirmOrganizationDelete"]');">
                                <label class="sr-only" for="organization-delete-@o.Id">@T["TypeDelete"]</label>
                                <input class="input confirmation-input" id="organization-delete-@o.Id" name="confirmation" placeholder="@T["TypeDelete"]" autocomplete="off" required pattern="DELETE" />
                                <button class="btn danger" type="submit">@T["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="muted">@T["NoOrganizations"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
