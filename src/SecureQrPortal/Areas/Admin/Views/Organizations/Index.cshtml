@model List<Organization>
@{ViewData["Title"]="Organizations";}
<div class="page-head"><div><h1>Organizations</h1><p>Manage entities, bilingual names and optional branding.</p></div><a class="btn primary" asp-action="Create">+ Organization</a></div><section class="panel"><div class="panel-head"><form method="get" class="actions"><input class="input" name="q" value="@Context.Request.Query["q"]" placeholder="Search organizations"><button class="btn secondary">Search</button></form></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Logo</th><th>English</th><th>Arabic</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@if(o.LogoPath is not null){<img src="@o.LogoPath" style="width:48px;height:48px;object-fit:contain;background:white;border-radius:10px;padding:4px">}</td><td>@o.NameEnglish @if(o.IsDemo){<span class="badge NOT_STARTED">DEMO</span>}</td><td dir="rtl">@o.NameArabic</td><td><span class="badge @(o.IsActive?"ACTIVE":"DISABLED")">@(o.IsActive?"ACTIVE":"DISABLED")</span></td><td>@o.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><div class="actions"><a class="btn secondary" asp-action="Edit" asp-route-id="@o.Id">Edit</a><form method="post" asp-action="Delete" asp-route-id="@o.Id" class="actions"><input class="input" name="confirmation" placeholder="Type DELETE" style="width:110px"><button class="btn danger">Delete</button></form></div></td></tr>}</tbody></table></div></section>
