@model AccessLogIndexVm
@{ViewData["Title"]="Access Logs";var orgs=(List<Organization>)ViewBag.Organizations;var pages=(IEnumerable<dynamic>)ViewBag.Pages;}
<div class="page-head"><div><h1>Access Logs</h1><p>QR scans, authentication attempts, content views and invalid-token activity.</p></div><a class="btn secondary" asp-action="ExportAccess" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-organizationId="@Model.OrganizationId" asp-route-securePageId="@Model.SecurePageId" asp-route-eventType="@Model.EventType" asp-route-success="@Model.Success" asp-route-ip="@Model.Ip">Export CSV</a></div>
<section class="panel"><div class="panel-body"><form method="get" class="filter-grid"><div class="field"><label>From (UTC)</label><input class="input" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"></div><div class="field"><label>To (UTC)</label><input class="input" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"></div><div class="field"><label>Organization</label><select class="select" name="organizationId"><option value="">All</option>@foreach(var o in orgs){<option value="@o.Id" selected="@(Model.OrganizationId==o.Id?"selected":null)">@o.NameEnglish</option>}</select></div><div class="field"><label>Secure Page</label><select class="select" name="securePageId"><option value="">All</option>@foreach(var p in pages){<option value="@p.Id" selected="@(Model.SecurePageId==(long)p.Id?"selected":null)">@p.QrReference — @p.TitleEnglish</option>}</select></div><div class="field"><label>Event</label><select class="select" name="eventType"><option value="">All events</option>@foreach(var e in Enum.GetNames<AccessEventType>()){<option value="@e" selected="@(Model.EventType==e?"selected":null)">@e</option>}</select></div><div class="field"><label>Result</label><select class="select" name="success"><option value="">All</option><option value="true" selected="@(Model.Success==true?"selected":null)">Success</option><option value="false" selected="@(Model.Success==false?"selected":null)">Failure</option></select></div><div class="field"><label>IP contains</label><input class="input" name="ip" placeholder="IP search" value="@Model.Ip"></div><div class="actions align-end"><button class="btn primary">Filter</button><a class="btn secondary" asp-action="Access">Reset</a></div></form></div></section>
<section class="panel"><div class="panel-head"><h2>@Model.Total events</h2></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Timestamp</th><th>Event</th><th>QR</th><th>Organization / Page</th><th>Result</th><th>IP</th><th>Browser / Device</th><th>Country</th><th>Internal reason</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@x.EventType</td><td>@(x.SecurePage?.QrReference??"—")</td><td>@(x.SecurePage?.Organization?.NameEnglish??"—")<br><span class="muted">@(x.SecurePage?.TitleEnglish??"Unknown token")</span></td><td>@(x.WasSuccessful?"SUCCESS":"FAILED")</td><td>@(x.IpAddress??"—")</td><td>@x.Browser / @x.DeviceType</td><td>@(x.Country??"—")</td><td>@x.FailureReasonInternal</td></tr>}@if(Model.Items.Count==0){<tr><td colspan="9" class="muted">No matching access events.</td></tr>}</tbody></table></div><div class="pagination">@if(Model.Page>1){<a asp-action="Access" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-organizationId="@Model.OrganizationId" asp-route-securePageId="@Model.SecurePageId" asp-route-eventType="@Model.EventType" asp-route-success="@Model.Success" asp-route-ip="@Model.Ip" asp-route-page="@(Model.Page-1)">‹</a>}<span>@Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a asp-action="Access" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-organizationId="@Model.OrganizationId" asp-route-securePageId="@Model.SecurePageId" asp-route-eventType="@Model.EventType" asp-route-success="@Model.Success" asp-route-ip="@Model.Ip" asp-route-page="@(Model.Page+1)">›</a>}</div></section>
