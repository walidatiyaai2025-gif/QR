@model AuditLogIndexVm
@{ViewData["Title"]="Audit Log";}
<div class="page-head"><div><h1>Audit Log</h1><p>Administrator operations without passwords, raw tokens, cookies or connection secrets.</p></div></div><section class="panel"><div class="panel-head"><h2>@Model.Total audit entries</h2></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Timestamp</th><th>Action</th><th>Entity</th><th>Entity ID</th><th>Admin</th><th>IP</th><th>Details</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@x.Action</td><td>@x.EntityType</td><td>@x.EntityId</td><td>@x.AdminUserId</td><td>@x.IpAddress</td><td>@x.Details</td></tr>}</tbody></table></div><div class="pagination">@if(Model.Page>1){<a asp-action="Audit" asp-route-page="@(Model.Page-1)">‹</a>}<span>@Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a asp-action="Audit" asp-route-page="@(Model.Page+1)">›</a>}</div></section>
