@using System.Globalization
@inject UiText T
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";
 var brandName=Branding.Name(ar);
 var path=Context.Request.Path.ToString();
 string Active(string x)=>path.Contains(x,StringComparison.OrdinalIgnoreCase)?"active":"";
}
<!doctype html><html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07111f"><title>@ViewData["Title"] — @brandName</title><link rel="icon" type="image/jpeg" href="@Branding.LogoPath"><link rel="apple-touch-icon" href="@Branding.LogoPath"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"><link rel="stylesheet" href="~/css/qr-share.css" asp-append-version="true"><link rel="stylesheet" href="~/css/branding.css" asp-append-version="true"></head>
<body class="admin-body"><div class="admin-shell"><aside class="sidebar" id="sidebar"><div class="sidebar-brand"><img class="sidebar-brand-logo" src="@Branding.LogoPath" alt="@brandName"><div><strong>@brandName</strong><small>@(ar?"لوحة الإدارة":"ADMIN CONSOLE")</small></div></div><nav>
<a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><span>◫</span>@T["Dashboard"]</a>
<a class="@Active("Organizations")" asp-area="Admin" asp-controller="Organizations" asp-action="Index"><span>◆</span>@T["Organizations"]</a>
<a class="@Active("SecurePages")" asp-area="Admin" asp-controller="SecurePages" asp-action="Index"><span>▤</span>@T["SecurePages"]</a>
<div class="nav-label">@T["QRManagement"]</div><a class="@Active("/Qr")" asp-area="Admin" asp-controller="Qr" asp-action="Index"><span>▦</span>@T["QrRegistry"]</a>
<div class="nav-label">@(ar?"السجلات":"LOGS")</div><a class="@Active("/Logs/Access")" asp-area="Admin" asp-controller="Logs" asp-action="Access"><span>◉</span>@T["AccessLogs"]</a><a class="@Active("/Logs/Audit")" asp-area="Admin" asp-controller="Logs" asp-action="Audit"><span>◎</span>@T["AuditLog"]</a>
<div class="nav-label">@T["Settings"]</div><a class="@Active("Settings/General")" asp-area="Admin" asp-controller="Settings" asp-action="General"><span>⚙</span>@T["General"]</a><a class="@Active("Settings/Database")" asp-area="Admin" asp-controller="Settings" asp-action="Database"><span>▣</span>@T["Database"]</a><a class="@Active("Settings/Backup")" asp-area="Admin" asp-controller="Settings" asp-action="Backup"><span>⇩</span>@T["Backup"]</a>
</nav><div class="sidebar-footer"><a asp-controller="Account" asp-area="" asp-action="ChangePassword">@(ar?"تغيير كلمة المرور":"Change password")</a><form asp-controller="Account" asp-area="" asp-action="Logout" method="post"><button class="link-button" type="submit">@T["Logout"]</button></form></div></aside>
<div class="admin-main"><header class="topbar"><button class="icon-button mobile-only" type="button" data-sidebar>☰</button><div class="topbar-title"><strong>@(ViewData["Title"]??brandName)</strong><span class="muted">@DateTime.Now.ToString(ar?"dd MMM yyyy":"MMM dd, yyyy")</span></div><div class="topbar-actions"><a class="lang-pill" href="/Localization/Switch?culture=@(ar?"en":"ar")&returnUrl=@Uri.EscapeDataString(Context.Request.Path+Context.Request.QueryString)">@(ar?"EN":"AR")</a></div></header>
<main class="admin-content">@if(TempData["Success"] is string ok){<div class="alert success">@ok</div>}@if(TempData["Error"] is string er){<div class="alert danger">@er</div>}@RenderBody()</main><footer class="admin-footer"><span class="admin-footer-brand"><img src="@Branding.LogoPath" alt="">@brandName</span><span>@AppVersion.Display</span></footer></div></div><div class="sidebar-scrim" data-sidebar-scrim></div><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",false)</body></html>
