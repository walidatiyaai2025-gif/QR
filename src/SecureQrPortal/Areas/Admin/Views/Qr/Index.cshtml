@model QrRegistryVm
@{
    ViewData["Title"] = "QR Code Registry";
    var orgs = (List<Organization>)ViewBag.Organizations;
}
<div class="page-head">
    <div><h1>QR Code Registry</h1><p>Centralized, server-authoritative inventory of every QR code generated by the system.</p></div>
    <div class="actions"><a class="btn secondary" asp-action="Export">Export CSV</a><a class="btn primary" asp-controller="SecurePages" asp-action="Create">+ Secure Page</a></div>
</div>

<section class="panel">
    <div class="panel-head"><h2>Search & Filters</h2><span class="muted">Search, filters, sorting and pagination execute on the server.</span></div>
    <div class="panel-body">
        <form method="get" class="filter-grid qr-filter-grid">
            <div class="field span-2"><label>Search</label><input class="input" name="search" value="@Model.Search" placeholder="Reference, organization, page, public token/URL, creator or status"></div>
            <div class="field"><label>Status</label><select class="select" name="statusFilter"><option value="">All</option>@foreach (var s in Enum.GetNames<QrStatus>()) { <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@s</option> }</select></div>
            <div class="field"><label>Organization</label><select class="select" name="organizationId"><option value="">All</option>@foreach (var o in orgs) { <option value="@o.Id" selected="@(Model.OrganizationId == o.Id ? "selected" : null)">@o.NameEnglish</option> }</select></div>
            <div class="field"><label>Access Limit Mode</label><select class="select" name="accessLimitMode"><option value="">All</option>@foreach (var m in Enum.GetValues<AccessLimitMode>()) { <option value="@m" selected="@(Model.AccessLimitMode == m ? "selected" : null)">@m</option> }</select></div>
            <div class="field"><label>Activity</label><select class="select" name="activity"><option value="">All</option><option value="today" selected="@(Model.Activity == "today" ? "selected" : null)">Used today</option><option value="never" selected="@(Model.Activity == "never" ? "selected" : null)">Never used</option><option value="7d" selected="@(Model.Activity == "7d" ? "selected" : null)">Used in last 7 days</option><option value="30d" selected="@(Model.Activity == "30d" ? "selected" : null)">Used in last 30 days</option><option value="expiring" selected="@(Model.Activity == "expiring" ? "selected" : null)">Expiring soon (7 days)</option></select></div>
            <div class="field"><label>Created From (UTC)</label><input class="input" type="date" name="createdFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Created To (UTC)</label><input class="input" type="date" name="createdTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Expiry From (UTC)</label><input class="input" type="date" name="expiryFrom" value="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Expiry To (UTC)</label><input class="input" type="date" name="expiryTo" value="@Model.ExpiryTo?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Page size</label><select class="select" name="pageSize">@foreach (var n in new[] { 10, 20, 50, 100 }) { <option value="@n" selected="@(Model.PageSize == n ? "selected" : null)">@n</option> }</select></div>
            <div class="actions align-end"><button class="btn primary">Apply Filters</button><a class="btn secondary" asp-action="Index">Reset</a></div>
        </form>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h2>@Model.Total QR Codes</h2>
        <div class="actions">
            <a class="muted" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-pageSize="@Model.PageSize" asp-route-sort="created_desc">Newest</a>
            <a class="muted" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-pageSize="@Model.PageSize" asp-route-sort="scan_desc">Last scanned</a>
            <a class="muted" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-pageSize="@Model.PageSize" asp-route-sort="expiry">Expiry</a>
        </div>
    </div>

    <div class="table-wrap responsive-hide qr-registry-scroll">
        <table class="data-table qr-registry-table">
            <thead><tr><th>QR</th><th>Reference</th><th>Organization / Page</th><th>Status</th><th>Public URL</th><th>Token Created</th><th>Validity</th><th>Limit</th><th>Usage</th><th>Last Activity</th><th>Ownership</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var x in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@x.Id"><img class="qr-thumb" src="@Url.Action("Code", new { id = x.Id, size = 4 })" alt="QR @x.Reference"></a></td>
                    <td><a class="code" asp-action="Details" asp-route-id="@x.Id">@x.Reference</a></td>
                    <td><strong>@x.Organization</strong><br><span class="muted">@x.PageTitle</span></td>
                    <td><span class="badge @x.Status">@x.Status</span></td>
                    <td class="url-cell"><div class="ellipsis">@x.PublicUrl</div><button class="link-button muted" type="button" data-copy="@x.PublicUrl">Copy URL</button></td>
                    <td>@x.TokenCreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td><span class="muted">From</span> @(x.ValidFromUtc?.ToLocalTime().ToString("dd MMM yy HH:mm") ?? "—")<br><span class="muted">To</span> @(x.ExpiresAtUtc?.ToLocalTime().ToString("dd MMM yy HH:mm") ?? "—")</td>
                    <td>@x.AccessLimitMode<br><span class="muted">Max @(x.MaxAccessCount?.ToString() ?? "∞") · Current @x.CurrentSuccessfulAccessCount</span></td>
                    <td><div class="stat-inline"><span>Opens @x.CurrentQrOpenCount</span><span>Access @x.CurrentSuccessfulAccessCount</span><span>Login @x.SuccessfulLoginCount</span><span>Failed @x.FailedLoginCount</span></div></td>
                    <td><span class="muted">Scan</span> @(x.LastQrScanAtUtc?.ToLocalTime().ToString("dd MMM HH:mm") ?? "Never")<br><span class="muted">Access</span> @(x.LastSuccessfulAccessAtUtc?.ToLocalTime().ToString("dd MMM HH:mm") ?? "Never")</td>
                    <td><strong>@x.CreatedBy</strong><br><span class="muted">Created @x.CreatedAtUtc.ToLocalTime().ToString("dd MMM yy HH:mm")</span><br><span class="muted">Updated @x.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yy HH:mm")</span></td>
                    <td><div class="actions compact-actions"><a class="btn secondary" asp-action="Details" asp-route-id="@x.Id">View</a><a class="btn secondary" asp-action="Download" asp-route-id="@x.Id">PNG</a><a class="btn secondary" asp-action="Print" asp-route-id="@x.Id" target="_blank">Print</a><a class="btn secondary" asp-controller="SecurePages" asp-action="Edit" asp-route-id="@x.Id">Edit</a><a class="btn secondary" href="@x.PublicUrl" target="_blank" rel="noopener">Open</a></div></td>
                </tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="12" class="muted">No QR codes match the selected criteria.</td></tr> }
            </tbody>
        </table>
    </div>

    <div class="mobile-cards">
    @foreach (var x in Model.Items)
    {
        <article class="mobile-card">
            <div class="qr-card-head"><img class="qr-thumb" src="@Url.Action("Code", new { id = x.Id, size = 4 })" alt="QR @x.Reference"><div><a class="code" asp-action="Details" asp-route-id="@x.Id">@x.Reference</a><div class="badge-row"><span class="badge @x.Status">@x.Status</span></div></div></div>
            <div class="row"><span>Organization</span><strong>@x.Organization</strong></div>
            <div class="row"><span>Page</span><span>@x.PageTitle</span></div>
            <div class="row"><span>Token created</span><span>@x.TokenCreatedAtUtc.ToLocalTime().ToString("dd MMM yy HH:mm")</span></div>
            <div class="row"><span>Scans / Access</span><span>@x.CurrentQrOpenCount / @x.CurrentSuccessfulAccessCount</span></div>
            <div class="row"><span>Login success / failed</span><span>@x.SuccessfulLoginCount / @x.FailedLoginCount</span></div>
            <div class="row"><span>Last scan</span><span>@(x.LastQrScanAtUtc?.ToLocalTime().ToString("dd MMM HH:mm") ?? "Never")</span></div>
            <div class="row"><span>Last access</span><span>@(x.LastSuccessfulAccessAtUtc?.ToLocalTime().ToString("dd MMM HH:mm") ?? "Never")</span></div>
            <div class="row"><span>Created by</span><span>@x.CreatedBy</span></div>
            <div class="actions"><a class="btn primary" asp-action="Details" asp-route-id="@x.Id">Details</a><a class="btn secondary" asp-action="Download" asp-route-id="@x.Id">PNG</a><button class="btn secondary" type="button" data-copy="@x.PublicUrl">Copy URL</button><a class="btn secondary" href="@x.PublicUrl" target="_blank" rel="noopener">Open</a></div>
        </article>
    }
    </div>

    <div class="pagination">
        @if (Model.Page > 1) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-sort="@Model.Sort">‹</a> }
        <span>@Model.Page / @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-sort="@Model.Sort">›</a> }
    </div>
</section>
