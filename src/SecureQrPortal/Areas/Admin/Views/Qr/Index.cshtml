@using Microsoft.EntityFrameworkCore
@model QrRegistryVm
@inject SecureQrPortal.Data.ApplicationDbContext Db
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string arText, string enText) => ar ? arText : enText;
    ViewData["Title"] = T["QrRegistry"];
    var orgs = (List<Organization>)ViewBag.Organizations;
    var itemIds = Model.Items.Select(x => x.Id).ToList();
    var localizedOrganizations = itemIds.Count == 0
        ? new Dictionary<long, string>()
        : await Db.SecurePages.AsNoTracking().Where(x => itemIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id, x => ar ? x.Organization.NameArabic : x.Organization.NameEnglish);
    var localizedTitles = itemIds.Count == 0
        ? new Dictionary<long, string>()
        : await Db.SecurePages.AsNoTracking().Where(x => itemIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id, x => ar ? x.TitleArabic : x.TitleEnglish);
    var previousArrow = ar ? "›" : "‹";
    var nextArrow = ar ? "‹" : "›";
}
<div class="page-head">
    <div><h1>@T["QrRegistry"]</h1><p>@L("سجل مركزي موثوق من الخادم لكل رموز QR التي أنشأها النظام.", "Centralized, server-authoritative inventory of every QR code generated by the system.")</p></div>
    <div class="actions"><a class="btn secondary" asp-action="Export">@T["ExportCsv"]</a><a class="btn primary" asp-controller="SecurePages" asp-action="Create">+ @T["NewSecurePage"]</a></div>
</div>

<section class="panel">
    <div class="panel-head"><h2>@L("البحث والتصفية", "Search & Filters")</h2><span class="muted">@L("البحث والتصفية والترتيب والتنقل بين الصفحات تنفذ على الخادم.", "Search, filters, sorting and pagination execute on the server.")</span></div>
    <div class="panel-body">
        <form method="get" class="filter-grid qr-filter-grid">
            <div class="field span-2"><label>@T["Search"]</label><input class="input" name="search" value="@Model.Search" placeholder="@L("المرجع، الجهة، الصفحة، الرابط العام، المنشئ أو الحالة", "Reference, organization, page, public token/URL, creator or status")"></div>
            <div class="field"><label>@T["Status"]</label><select class="select" name="statusFilter"><option value="">@T["All"]</option>@foreach (var s in Enum.GetNames<QrStatus>()) { <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@T[s]</option> }</select></div>
            <div class="field"><label>@T["Organization"]</label><select class="select" name="organizationId"><option value="">@T["All"]</option>@foreach (var o in orgs) { <option value="@o.Id" selected="@(Model.OrganizationId == o.Id ? "selected" : null)">@(ar ? o.NameArabic : o.NameEnglish)</option> }</select></div>
            <div class="field"><label>@T["AccessLimitMode"]</label><select class="select" name="accessLimitMode"><option value="">@T["All"]</option>@foreach (var m in Enum.GetValues<AccessLimitMode>()) { <option value="@m" selected="@(Model.AccessLimitMode == m ? "selected" : null)">@T[m.ToString()]</option> }</select></div>
            <div class="field"><label>@L("النشاط", "Activity")</label><select class="select" name="activity"><option value="">@T["All"]</option><option value="today" selected="@(Model.Activity == "today" ? "selected" : null)">@L("مستخدم اليوم", "Used today")</option><option value="never" selected="@(Model.Activity == "never" ? "selected" : null)">@L("لم يستخدم", "Never used")</option><option value="7d" selected="@(Model.Activity == "7d" ? "selected" : null)">@L("مستخدم خلال آخر 7 أيام", "Used in last 7 days")</option><option value="30d" selected="@(Model.Activity == "30d" ? "selected" : null)">@L("مستخدم خلال آخر 30 يوماً", "Used in last 30 days")</option><option value="expiring" selected="@(Model.Activity == "expiring" ? "selected" : null)">@L("ينتهي قريباً خلال 7 أيام", "Expiring soon (7 days)")</option></select></div>
            <div class="field"><label>@L("تاريخ الإنشاء من (UTC)", "Created From (UTC)")</label><input class="input" type="date" name="createdFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>@L("تاريخ الإنشاء إلى (UTC)", "Created To (UTC)")</label><input class="input" type="date" name="createdTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>@L("تاريخ الانتهاء من (UTC)", "Expiry From (UTC)")</label><input class="input" type="date" name="expiryFrom" value="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>@L("تاريخ الانتهاء إلى (UTC)", "Expiry To (UTC)")</label><input class="input" type="date" name="expiryTo" value="@Model.ExpiryTo?.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>@T["PageSize"]</label><select class="select" name="pageSize">@foreach (var n in new[] { 10, 20, 50, 100 }) { <option value="@n" selected="@(Model.PageSize == n ? "selected" : null)">@n</option> }</select></div>
            <div class="actions align-end"><button class="btn primary">@L("تطبيق الفلاتر", "Apply Filters")</button><a class="btn secondary" asp-action="Index">@T["Reset"]</a></div>
        </form>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h2>@Model.Total @L("رمز QR", "QR Codes")</h2>
        <div class="actions">
            <a class="muted" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-pageSize="@Model.PageSize" asp-route-sort="created_desc">@L("الأحدث", "Newest")</a>
            <a class="muted" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-pageSize="@Model.PageSize" asp-route-sort="scan_desc">@L("آخر مسح", "Last scanned")</a>
            <a class="muted" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-pageSize="@Model.PageSize" asp-route-sort="expiry">@T["Expiry"]</a>
        </div>
    </div>

    <div class="table-wrap responsive-hide qr-registry-scroll">
        <table class="data-table qr-registry-table">
            <thead><tr><th>QR</th><th>@L("المرجع", "Reference")</th><th>@T["OrganizationPage"]</th><th>@T["Status"]</th><th>@L("الرابط العام", "Public URL")</th><th>@L("إنشاء الرمز", "Token Created")</th><th>@L("الصلاحية", "Validity")</th><th>@L("الحد", "Limit")</th><th>@L("الاستخدام", "Usage")</th><th>@L("آخر نشاط", "Last Activity")</th><th>@L("الملكية", "Ownership")</th><th>@T["Actions"]</th></tr></thead>
            <tbody>
            @foreach (var x in Model.Items)
            {
                var displayOrg = localizedOrganizations.TryGetValue(x.Id, out var lo) ? lo : x.Organization;
                var displayTitle = localizedTitles.TryGetValue(x.Id, out var lt) ? lt : x.PageTitle;
                <tr>
                    <td><a asp-action="Details" asp-route-id="@x.Id"><img class="qr-thumb" src="@Url.Action("Code", new { id = x.Id, size = 4 })" alt="QR @x.Reference"></a></td>
                    <td><a class="code" asp-action="Details" asp-route-id="@x.Id">@x.Reference</a></td>
                    <td><strong>@displayOrg</strong><br><span class="muted">@displayTitle</span></td>
                    <td><span class="badge @x.Status">@T[x.Status.ToString()]</span></td>
                    <td class="url-cell"><div class="ellipsis" dir="ltr">@x.PublicUrl</div><button class="link-button muted" type="button" data-copy="@x.PublicUrl">@L("نسخ الرابط", "Copy URL")</button></td>
                    <td>@x.TokenCreatedAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yyyy HH:mm" : "dd MMM yyyy HH:mm")</td>
                    <td><span class="muted">@L("من", "From")</span> @(x.ValidFromUtc?.ToLocalTime().ToString(ar ? "dd/MM/yy HH:mm" : "dd MMM yy HH:mm") ?? "—")<br><span class="muted">@L("إلى", "To")</span> @(x.ExpiresAtUtc?.ToLocalTime().ToString(ar ? "dd/MM/yy HH:mm" : "dd MMM yy HH:mm") ?? "—")</td>
                    <td>@T[x.AccessLimitMode.ToString()]<br><span class="muted">@L("الأقصى", "Max") @(x.MaxAccessCount?.ToString() ?? "∞") · @L("الحالي", "Current") @x.CurrentSuccessfulAccessCount</span></td>
                    <td><div class="stat-inline"><span>@L("فتح", "Opens") @x.CurrentQrOpenCount</span><span>@L("وصول", "Access") @x.CurrentSuccessfulAccessCount</span><span>@L("دخول", "Login") @x.SuccessfulLoginCount</span><span>@L("فشل", "Failed") @x.FailedLoginCount</span></div></td>
                    <td><span class="muted">@L("مسح", "Scan")</span> @(x.LastQrScanAtUtc?.ToLocalTime().ToString(ar ? "dd/MM HH:mm" : "dd MMM HH:mm") ?? L("لم يحدث", "Never"))<br><span class="muted">@L("وصول", "Access")</span> @(x.LastSuccessfulAccessAtUtc?.ToLocalTime().ToString(ar ? "dd/MM HH:mm" : "dd MMM HH:mm") ?? L("لم يحدث", "Never"))</td>
                    <td><strong>@x.CreatedBy</strong><br><span class="muted">@L("أُنشئ", "Created") @x.CreatedAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yy HH:mm" : "dd MMM yy HH:mm")</span><br><span class="muted">@L("حُدث", "Updated") @x.UpdatedAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yy HH:mm" : "dd MMM yy HH:mm")</span></td>
                    <td><div class="actions compact-actions"><a class="btn secondary" asp-action="Details" asp-route-id="@x.Id">@T["Details"]</a><a class="btn secondary" asp-action="Download" asp-route-id="@x.Id">PNG</a><a class="btn secondary" asp-action="Print" asp-route-id="@x.Id" target="_blank">@L("طباعة", "Print")</a><a class="btn secondary" asp-controller="SecurePages" asp-action="Edit" asp-route-id="@x.Id">@T["Edit"]</a><a class="btn secondary" href="@x.PublicUrl" target="_blank" rel="noopener">@L("فتح", "Open")</a></div></td>
                </tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="12" class="muted">@L("لا توجد رموز QR تطابق معايير البحث المحددة.", "No QR codes match the selected criteria.")</td></tr> }
            </tbody>
        </table>
    </div>

    <div class="mobile-cards">
    @foreach (var x in Model.Items)
    {
        var displayOrg = localizedOrganizations.TryGetValue(x.Id, out var lo) ? lo : x.Organization;
        var displayTitle = localizedTitles.TryGetValue(x.Id, out var lt) ? lt : x.PageTitle;
        <article class="mobile-card">
            <div class="qr-card-head"><img class="qr-thumb" src="@Url.Action("Code", new { id = x.Id, size = 4 })" alt="QR @x.Reference"><div><a class="code" asp-action="Details" asp-route-id="@x.Id">@x.Reference</a><div class="badge-row"><span class="badge @x.Status">@T[x.Status.ToString()]</span></div></div></div>
            <div class="row"><span>@T["Organization"]</span><strong>@displayOrg</strong></div>
            <div class="row"><span>@T["Page"]</span><span>@displayTitle</span></div>
            <div class="row"><span>@L("إنشاء الرمز", "Token created")</span><span>@x.TokenCreatedAtUtc.ToLocalTime().ToString(ar ? "dd/MM/yy HH:mm" : "dd MMM yy HH:mm")</span></div>
            <div class="row"><span>@L("المسح / الوصول", "Scans / Access")</span><span>@x.CurrentQrOpenCount / @x.CurrentSuccessfulAccessCount</span></div>
            <div class="row"><span>@L("دخول ناجح / فاشل", "Login success / failed")</span><span>@x.SuccessfulLoginCount / @x.FailedLoginCount</span></div>
            <div class="row"><span>@L("آخر مسح", "Last scan")</span><span>@(x.LastQrScanAtUtc?.ToLocalTime().ToString(ar ? "dd/MM HH:mm" : "dd MMM HH:mm") ?? L("لم يحدث", "Never"))</span></div>
            <div class="row"><span>@L("آخر وصول", "Last access")</span><span>@(x.LastSuccessfulAccessAtUtc?.ToLocalTime().ToString(ar ? "dd/MM HH:mm" : "dd MMM HH:mm") ?? L("لم يحدث", "Never"))</span></div>
            <div class="row"><span>@L("أنشأ بواسطة", "Created by")</span><span>@x.CreatedBy</span></div>
            <div class="actions"><a class="btn primary" asp-action="Details" asp-route-id="@x.Id">@T["Details"]</a><a class="btn secondary" asp-action="Download" asp-route-id="@x.Id">PNG</a><button class="btn secondary" type="button" data-copy="@x.PublicUrl">@L("نسخ الرابط", "Copy URL")</button><a class="btn secondary" href="@x.PublicUrl" target="_blank" rel="noopener">@L("فتح", "Open")</a></div>
        </article>
    }
    </div>

    <nav class="pagination" aria-label="@T["Pagination"]">
        @if (Model.Page > 1) { <a aria-label="@T["PreviousPage"]" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-sort="@Model.Sort">@previousArrow</a> }
        <span>@Model.Page / @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages) { <a aria-label="@T["NextPage"]" asp-action="Index" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-activity="@Model.Activity" asp-route-createdFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" asp-route-createdTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")" asp-route-expiryFrom="@Model.ExpiryFrom?.ToString("yyyy-MM-dd")" asp-route-expiryTo="@Model.ExpiryTo?.ToString("yyyy-MM-dd")" asp-route-accessLimitMode="@Model.AccessLimitMode" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-sort="@Model.Sort">@nextArrow</a> }
    </nav>
</section>
