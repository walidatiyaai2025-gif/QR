@model SecurePage
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="stylesheet" href="/css/site.css"><title>@Model.QrReference</title></head><body style="background:#eee"><div class="print-sheet"><div class="no-print" style="margin-bottom:18px"><button class="btn primary" onclick="window.print()">Print</button></div>@if(Model.Organization.LogoPath is not null){<img src="@Model.Organization.LogoPath" style="width:120px;height:120px;object-fit:contain" alt="Logo">}<h1>@Model.Organization.NameEnglish</h1><h2>@Model.TitleEnglish</h2><img src="@Url.Action("Code",new{id=Model.Id,size=12})" alt="QR"><p><strong>@Model.QrReference</strong></p><p>Scan to open the secure page.</p></div></body></html>
