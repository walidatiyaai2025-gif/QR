@using System.Globalization
@model SecurePage
@{
    Layout = null;
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var org = ar ? Model.Organization.NameArabic : Model.Organization.NameEnglish;
    var brandName = Branding.Name(ar);
}
<!doctype html>
<html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/branding.css">
    <title>@Model.QrReference — @brandName</title>
</head>
<body style="background:#eee">
<div class="print-sheet diwan-print-sheet">
    <div class="no-print" style="margin-bottom:18px"><button class="btn primary" onclick="window.print()">@(ar?"طباعة":"Print")</button></div>
    <img class="print-diwan-logo" src="@Branding.LogoPath" alt="@brandName">
    <h1 class="print-brand-name">@brandName</h1>
    <div class="qr-org-title print-org-title">@org</div>
    <div class="qr-print-block">
        <img src="@Url.Action("Code",new{id=Model.Id,size=12})" alt="QR">
    </div>
    <p><strong>@Model.QrReference</strong></p>
    <p>@(ar?"امسح رمز QR لفتح الصفحة الآمنة.":"Scan the QR code to open the secure page.")</p>
</div>
</body>
</html>
