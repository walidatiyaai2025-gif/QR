@model QrDetailsVm
@{
    ViewData["Title"] = "QR Details";
    var p = Model.Page;
    var now = DateTime.UtcNow;
    var pageExpiry = p.ExpiresAtUtc;
}

<div class="page-head">
    <div>
        <h1>@p.QrReference</h1>
        <p>@p.Organization.NameEnglish · @p.TitleEnglish</p>
    </div>
    <div class="actions">
        <a class="btn secondary" asp-action="Index">Registry</a>
        <a class="btn secondary" asp-controller="SecurePages" asp-action="Edit" asp-route-id="@p.Id">Edit Page</a>
        <a class="btn primary" asp-action="Download" asp-route-id="@p.Id">Download PNG</a>
    </div>
</div>

<div class="details-grid">
    <div>
        <section class="panel">
            <div class="panel-head">
                <h2>Identity</h2>
                <span class="badge @Model.Status">@Model.Status</span>
            </div>
            <div class="panel-body">
                <div class="identity-block">
                    <img class="qr-large" src="@Url.Action("Code", new { id = p.Id, size = 8 })" alt="QR">
                    <dl class="kv">
                        <dt>QR Reference</dt><dd class="code">@p.QrReference</dd>
                        <dt>Organization</dt><dd>@p.Organization.NameEnglish / <span dir="rtl">@p.Organization.NameArabic</span></dd>
                        <dt>Secure Page</dt><dd>@p.TitleEnglish</dd>
                        <dt>Public URL</dt>
                        <dd class="secure-url-admin"><span>@Model.PublicUrl</span> <button type="button" class="link-button" style="color:var(--gold2)" data-copy="@Model.PublicUrl">Copy</button></dd>
                        <dt>Secure token</dt><dd class="code">@Model.MaskedToken</dd>
                        <dt>Current token created</dt><dd>@p.CurrentTokenCreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</dd>
                    </dl>
                </div>
                <div class="actions" style="margin-top:18px">
                    <a class="btn secondary" href="@Model.PublicUrl" target="_blank" rel="noopener">Open Public URL</a>
                    <a class="btn secondary" asp-action="Print" asp-route-id="@p.Id" target="_blank">Print</a>
                    <a class="btn secondary" asp-controller="Logs" asp-action="Access" asp-route-eventType="">Activity Logs</a>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head"><h2>Validity & Usage</h2></div>
            <div class="panel-body">
                <dl class="kv">
                    <dt>Valid From</dt><dd>@(p.ValidFromUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Immediately")</dd>
                    <dt>Expiry Date</dt><dd>@(pageExpiry?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "No expiry")</dd>
                    <dt>Remaining Validity</dt>
                    <dd>
                        @if (pageExpiry is DateTime expiry)
                        {
                            if (expiry > now)
                            {
                                <text>@Math.Floor((expiry - now).TotalDays) days</text>
                            }
                            else
                            {
                                <text>Expired</text>
                            }
                        }
                        else
                        {
                            <text>Unlimited</text>
                        }
                    </dd>
                    <dt>Access Limit Mode</dt><dd>@p.AccessLimitMode</dd>
                    <dt>Maximum Accesses</dt><dd>@(p.MaxAccessCount?.ToString() ?? "Unlimited")</dd>
                    <dt>Remaining Accesses</dt><dd>@(Model.RemainingAccesses?.ToString() ?? "Unlimited")</dd>
                    <dt>Total QR Opens</dt><dd>@p.CurrentQrOpenCount</dd>
                    <dt>Successful Logins</dt><dd>@p.CurrentSuccessfulLoginCount</dd>
                    <dt>Failed Logins</dt><dd>@p.CurrentFailedLoginCount</dd>
                    <dt>Successful Content Accesses</dt><dd>@p.CurrentSuccessfulAccessCount</dd>
                    <dt>Last Scan</dt><dd>@(p.LastQrScanAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss") ?? "Never")</dd>
                    <dt>Last Successful Access</dt><dd>@(p.LastSuccessfulAccessAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss") ?? "Never")</dd>
                </dl>
            </div>
        </section>
    </div>

    <div>
        <section class="panel">
            <div class="panel-head"><h2>Ownership</h2></div>
            <div class="panel-body">
                <dl class="kv">
                    <dt>Created By</dt><dd>@Model.CreatedBy</dd>
                    <dt>Created At</dt><dd>@p.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</dd>
                    <dt>Modified By</dt><dd>@Model.ModifiedBy</dd>
                    <dt>Last Updated</dt><dd>@p.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</dd>
                    <dt>Token regenerations</dt><dd>@Model.History.Count</dd>
                </dl>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head"><h2>Activity Timeline</h2><span class="muted">Latest 100 events</span></div>
            <div class="panel-body">
                <div class="timeline">
                    @foreach (var x in Model.Timeline)
                    {
                        <div class="timeline-item">
                            <strong>@x.EventType — @(x.WasSuccessful ? "SUCCESS" : "FAILED")</strong>
                            <small>@x.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss") · IP @(x.IpAddress ?? "—") · @x.Browser / @x.DeviceType @if (!string.IsNullOrWhiteSpace(x.Country)) { <text> · @x.Country</text> }</small>
                        </div>
                    }
                    @if (Model.Timeline.Count == 0)
                    {
                        <p class="muted">No activity recorded.</p>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>Share QR Access</h2>
            <span class="muted">Create a temporary link that reveals temporary QR credentials with a hard expiry.</span>
        </div>
    </div>
    <div class="panel-body">
        <form asp-action="CreateShare" asp-route-id="@p.Id" method="post">
            <div class="share-config-grid">
                <div class="field">
                    <label>Allowed credential reveals</label>
                    <input class="input" type="number" name="maxOpenCount" min="1" max="100" value="1" required>
                    <small class="muted">1 = one-time credential reveal.</small>
                </div>
                <div class="field">
                    <label>Share link lifetime (hours)</label>
                    <input class="input" type="number" name="linkLifetimeHours" min="1" max="720" value="24" required>
                </div>
                <div class="field">
                    <label>Access window after reveal (minutes)</label>
                    <input class="input" type="number" name="sessionDurationMinutes" min="1" max="1440" value="15" required>
                    <small class="muted">Temporary credentials stop working at this hard deadline.</small>
                </div>
                <div class="field share-create-action">
                    <label>&nbsp;</label>
                    <button class="btn primary" type="submit">Create Secure Share Link</button>
                </div>
            </div>
        </form>
        <div class="share-instruction">The recipient sees a warning that the link has a limited reveal count. Simply previewing the link does not consume it; the count is consumed only when credentials are explicitly revealed, preventing mail/WhatsApp link scanners from burning a one-time link.</div>
    </div>

    @if (Model.ShareLinks.Count > 0)
    {
        <div class="table-wrap">
            <table class="data-table share-table">
                <thead>
                    <tr><th>Status</th><th>Share Link</th><th>Reveals</th><th>Expires</th><th>Session</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.ShareLinks)
                    {
                        var sh = s.Share;
                        var shareStatus = sh.RevokedAtUtc.HasValue ? "REVOKED" : sh.ExpiresAtUtc <= now ? "EXPIRED" : sh.CurrentOpenCount >= sh.MaxOpenCount ? "LIMIT_REACHED" : "ACTIVE";
                        var accessWindowEnd = sh.AccessWindowEndsAtUtc;
                        <tr>
                            <td><span class="badge @shareStatus">@shareStatus</span></td>
                            <td>
                                <div class="share-url-cell">@s.ShareUrl</div>
                                <div class="muted">Created @sh.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                            </td>
                            <td>@sh.CurrentOpenCount / @sh.MaxOpenCount</td>
                            <td>@sh.ExpiresAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @sh.SessionDurationMinutes min
                                @if (accessWindowEnd is DateTime windowEnd)
                                {
                                    <br><span class="muted">window ends @windowEnd.ToLocalTime().ToString("HH:mm:ss")</span>
                                }
                            </td>
                            <td>
                                <div class="actions share-actions">
                                    <button type="button" class="btn secondary" data-copy="@s.ShareUrl">Copy</button>
                                    <a class="btn secondary" href="@s.WhatsAppUrl" target="_blank" rel="noopener">WhatsApp</a>
                                    <a class="btn secondary" href="@s.EmailUrl">Email</a>
                                    @if (!sh.RevokedAtUtc.HasValue && sh.ExpiresAtUtc > now)
                                    {
                                        <form asp-action="RevokeShare" asp-route-id="@p.Id" asp-route-shareId="@sh.Id" method="post" onsubmit="return confirm('Revoke this share link immediately?');">
                                            <input type="hidden" name="confirmation" value="REVOKE SHARE">
                                            <button class="btn danger" type="submit">Revoke</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-head"><h2>Token History</h2><span class="muted">Previous tokens are stored only as hashes</span></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Revoked</th><th>Previous Token Hash</th><th>Reason</th><th>Replacement</th></tr></thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@h.RevokedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td class="code">@(h.PreviousTokenHash.Length > 16 ? h.PreviousTokenHash[..16] : h.PreviousTokenHash)…</td>
                        <td>@h.RevocationReason</td>
                        <td>@h.ReplacementTokenCreatedAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
                @if (Model.History.Count == 0)
                {
                    <tr><td colspan="4" class="muted">Token has never been regenerated.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="panel danger-zone">
    <div class="panel-head"><h2>Administrative Actions</h2><span class="muted">Dangerous operations require explicit confirmation</span></div>
    <div class="panel-body">
        <div class="details-grid">
            <form asp-action="Regenerate" asp-route-id="@p.Id" method="post">
                <div class="field"><label>Regenerate QR token — type REGENERATE</label><input class="input" name="confirmation" autocomplete="off"></div>
                <button class="btn danger">Regenerate & invalidate old QR</button>
            </form>
            <form asp-action="Revoke" asp-route-id="@p.Id" method="post">
                <div class="field"><label>Revoke QR/page — type REVOKE</label><input class="input" name="confirmation" autocomplete="off"></div>
                <button class="btn danger">Revoke</button>
            </form>
            <form asp-action="ResetCounter" asp-route-id="@p.Id" method="post">
                <div class="field"><label>Reset access/open counters — type RESET</label><input class="input" name="confirmation" autocomplete="off"></div>
                <button class="btn danger">Reset counters</button>
            </form>
            <form asp-controller="SecurePages" asp-action="Toggle" asp-route-id="@p.Id" method="post">
                <div class="field"><label>Availability</label><p class="muted">Server-side active/disabled state.</p></div>
                <button class="btn secondary">@(p.IsActive ? "Disable" : "Enable") QR/Page</button>
            </form>
        </div>
    </div>
</section>
