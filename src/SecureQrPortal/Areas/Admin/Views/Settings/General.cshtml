@model GeneralSettingsVm
@{ ViewData["Title"] = T["GeneralSettings"]; }
<link rel="stylesheet" href="~/css/admin-closure.css" asp-append-version="true" />
<div class="page-head">
    <div>
        <h1>@T["GeneralSettings"]</h1>
        <p>@T["GeneralSettingsSubtitle"]</p>
    </div>
</div>
<section class="panel">
    <div class="panel-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="ApplicationName">@T["ApplicationName"]</label>
                    <input class="input" asp-for="ApplicationName" required autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="DefaultLanguage">@T["DefaultLanguage"]</label>
                    <select class="select" asp-for="DefaultLanguage"><option value="ar">@T["ArabicLanguage"]</option><option value="en">@T["EnglishLanguage"]</option></select>
                </div>
                <div class="field span-2">
                    <label asp-for="LoginFooterText">@T["LoginFooterText"]</label>
                    <input class="input" asp-for="LoginFooterText" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="DefaultQrSize">@T["DefaultQrSize"]</label>
                    <input class="input" asp-for="DefaultQrSize" type="number" min="4" max="30" inputmode="numeric" />
                </div>
                <div class="field">
                    <label asp-for="SessionTimeoutMinutes">@T["SessionTimeoutMinutes"]</label>
                    <input class="input" asp-for="SessionTimeoutMinutes" type="number" min="5" max="240" inputmode="numeric" />
                </div>
                <div class="field">
                    <label asp-for="TimeZone">@T["TimeZone"]</label>
                    <input class="input" asp-for="TimeZone" placeholder="Asia/Kuwait" autocomplete="off" dir="ltr" />
                </div>
                <label class="check" asp-for="ShowExpiryPublicly"><input asp-for="ShowExpiryPublicly" /> @T["ShowExpiryPublicly"]</label>
            </div>
            <div class="actions mobile-stack" style="margin-top:20px"><button class="btn primary" type="submit">@T["SaveSettings"]</button></div>
        </form>
    </div>
</section>
