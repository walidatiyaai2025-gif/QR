@{ViewData["Title"]="Backup";var history=(IEnumerable<FileInfo>)ViewBag.History;var sqlite=(bool)ViewBag.IsSqlite;}
<div class="page-head"><div><h1>Backup & Restore</h1><p>Verified local SQLite backup with protected restore staging.</p></div></div>@if(!sqlite){<div class="alert danger">Native SQL Server backup requires appropriate SQL Server/server privileges. This screen does not claim to perform server-native backups.</div>}else{<section class="panel"><div class="panel-head"><h2>Create SQLite Backup</h2><span class="muted">WAL checkpoint + file verification</span></div><div class="panel-body"><form method="post" asp-action="CreateBackup"><button class="btn primary">Create Local Backup</button></form></div></section><section class="panel"><div class="panel-head"><h2>Restore SQLite Backup</h2><span class="muted">Applied on next restart</span></div><div class="panel-body"><form method="post" asp-action="RestoreBackup" enctype="multipart/form-data"><div class="field"><label>SQLite backup file</label><input class="input" type="file" name="backupFile" accept=".db" required></div><div class="field"><label>Type RESTORE to confirm</label><input class="input" name="confirmation" autocomplete="off"></div><button class="btn danger">Stage Restore</button></form></div></section><section class="panel"><div class="panel-head"><h2>Backup History</h2></div><div class="table-wrap"><table class="data-table"><thead><tr><th>File</th><th>Created UTC</th><th>Size</th><th>Action</th></tr></thead><tbody>@foreach(var f in history){<tr><td>@f.Name</td><td>@f.CreationTimeUtc.ToString("dd MMM yyyy HH:mm:ss")</td><td>@Math.Round(f.Length/1024d/1024d,2) MB</td><td><a class="btn secondary" asp-action="DownloadBackup" asp-route-file="@f.Name">Download</a></td></tr>}</tbody></table></div></section>}
