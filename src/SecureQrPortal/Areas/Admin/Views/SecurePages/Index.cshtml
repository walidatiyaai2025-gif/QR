@inject QrStatusService Statuses
@model SecurePageIndexVm
@{ViewData["Title"]="Secure Pages";var orgs=(List<Organization>)ViewBag.Organizations;}
<div class="page-head"><div><h1>Secure Pages</h1><p>Content, credentials, validity, status and access policies.</p></div><a class="btn primary" asp-action="Create">+ Secure Page</a></div>
<section class="panel"><div class="panel-body"><form method="get" class="filter-grid"><div class="field span-2"><label>Search</label><input class="input" name="q" value="@Model.Search" placeholder="Reference, organization or title"></div><div class="field"><label>Status</label><select class="select" name="statusFilter"><option value="">All</option>@foreach(var s in Enum.GetNames<QrStatus>()){<option value="@s" selected="@(Model.Status==s?"selected":null)">@s</option>}</select></div><div class="field"><label>Organization</label><select class="select" name="organizationId"><option value="">All</option>@foreach(var o in orgs){<option value="@o.Id" selected="@(Model.OrganizationId==o.Id?"selected":null)">@o.NameEnglish</option>}</select></div><div class="field"><label>Page size</label><select class="select" name="pageSize">@foreach(var n in new[]{10,20,50,100}){<option value="@n" selected="@(Model.PageSize==n?"selected":null)">@n</option>}</select></div><div class="actions align-end"><button class="btn primary">Apply</button><a class="btn secondary" asp-action="Index">Reset</a></div></form></div></section>
<section class="panel"><div class="panel-head"><h2>@Model.Total Secure Pages</h2><div class="actions"><a class="muted" asp-action="Index" asp-route-q="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-pageSize="@Model.PageSize" asp-route-sort="created_desc">Newest</a><a class="muted" asp-action="Index" asp-route-q="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-pageSize="@Model.PageSize" asp-route-sort="expiry">Expiry</a><a class="muted" asp-action="Index" asp-route-q="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-pageSize="@Model.PageSize" asp-route-sort="ref">Reference</a></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Reference</th><th>Organization</th><th>Page</th><th>Status</th><th>Usage</th><th>Expiry</th><th>Updated</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model.Items){var s=Statuses.GetStatus(p);<tr><td><a class="code" asp-controller="Qr" asp-action="Details" asp-route-id="@p.Id">@p.QrReference</a></td><td>@p.Organization.NameEnglish</td><td>@p.TitleEnglish</td><td><span class="badge @s">@s</span></td><td>@p.CurrentSuccessfulAccessCount / @(p.MaxAccessCount?.ToString()??"∞")<br><span class="muted">@p.CurrentQrOpenCount opens</span></td><td>@(p.ExpiresAtUtc?.ToLocalTime().ToString("dd MMM yyyy")??"—")</td><td>@p.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yy HH:mm")</td><td><div class="actions"><a class="btn secondary" asp-action="Edit" asp-route-id="@p.Id">Edit</a><a class="btn secondary" asp-action="Preview" asp-route-id="@p.Id" target="_blank">Preview</a><a class="btn secondary" asp-controller="Qr" asp-action="Details" asp-route-id="@p.Id">QR</a><form asp-action="Duplicate" asp-route-id="@p.Id" method="post"><button class="btn secondary">Duplicate</button></form><form asp-action="Toggle" asp-route-id="@p.Id" method="post"><button class="btn secondary">@(p.IsActive?"Disable":"Enable")</button></form><form asp-action="Delete" asp-route-id="@p.Id" method="post" class="actions"><input class="input" name="confirmation" placeholder="DELETE" style="width:86px"><button class="btn danger">Delete</button></form></div></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="8" class="muted">No secure pages match the selected criteria.</td></tr>}</tbody></table></div><div class="pagination">@if(Model.Page>1){<a asp-action="Index" asp-route-q="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize" asp-route-sort="@Model.Sort">‹</a>}<span>@Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a asp-action="Index" asp-route-q="@Model.Search" asp-route-statusFilter="@Model.Status" asp-route-organizationId="@Model.OrganizationId" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize" asp-route-sort="@Model.Sort">›</a>}</div></section>
